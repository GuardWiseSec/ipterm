# Headers for static files served directly by Cloudflare (the Worker isn't involved for these,
# so it can't add headers itself). Pages and the API get their headers from src/worker.js.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'none'; style-src 'unsafe-inline'; img-src 'self' data:; frame-ancestors 'none'

# Public docs: browser-based OpenAPI tools and agents on other sites may fetch these. The API itself
# stays same-origin unless PUBLIC_API is "true" in wrangler.toml.
/openapi.json
  Access-Control-Allow-Origin: *

/llms.txt
  Access-Control-Allow-Origin: *

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.ico
  Cache-Control: public, max-age=86400

/favicon.svg
  Cache-Control: public, max-age=86400

/apple-touch-icon.png
  Cache-Control: public, max-age=86400

/icon-192.png
  Cache-Control: public, max-age=86400

/icon-512.png
  Cache-Control: public, max-age=86400

/og.png
  Cache-Control: public, max-age=86400

/og-leak-a.png
