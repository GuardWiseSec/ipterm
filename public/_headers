# Headers for static files served directly by Cloudflare (the Worker isn't involved for these,
# so it can't add headers itself). Pages and the API get their headers from src/worker.js.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'none'; style-src 'unsafe-inline'; img-src 'self' data:; frame-ancestors 'none'

# Public docs: browser-based OpenAPI tools and agents on other sites may fetch these. The API itself
# stays same-origin unless PUBLIC_API is "true" in wrangler.toml.
/openapi.json
  Access-Control-Allow-Origin: *

/llms.txt
  Access-Control-Allow-Origin: *

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# The pages link these with their version (?v=, from the file's ETag: assetVersions() in src/worker.js), so a changed
# file gets a new address and browsers keep each one a day without asking again. Not longer, and not immutable: while
# a deploy spreads, a page from the new version can have its files answered by a place still on the old one (static
# files ignore the query), and the browser keeps that old file under the new address for as long as this says. Every
# page that links one goes through the Worker's assetLinks(): a bare link (no ?v=) would keep an old copy a day.
/app.css
  Cache-Control: public, max-age=86400

/app.js
  Cache-Control: public, max-age=86400

/prefs.js
  Cache-Control: public, max-age=86400

/cidr.js
  Cache-Control: public, max-age=86400

/land.js
  Cache-Control: public, max-age=86400

/ports.js
  Cache-Control: public, max-age=86400

/resolvers.js
  Cache-Control: public, max-age=86400

/leakgrade.js
  Cache-Control: public, max-age=86400

# The sponsored line's list: fetched by every terminal page as app.js starts. Five minutes, as the pages themselves.
/sponsors.json
